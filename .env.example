# Copie para .env e execute: node --env-file=.env server.mjs
HOST=127.0.0.1
PORT=3080
# Opcional: gere dois tokens distintos com pelo menos 24 caracteres.
# Sem estes valores, o servidor cria tokens locais em data/credentials.json.
CRM_ADMIN_TOKEN=
CRM_AGENT_TOKEN=
# As chaves das integrações (Apify, AISA, Jev/TypeSafe, Resend) NÃO vão aqui:
# a tela Integrações do CRM grava em $HERMES_HOME/.env.

# Custos máximos por chamada, apenas para o processo do worker.
# Também podem ficar no arquivo de integrações do Hermes.
# Defina conforme a cobrança contratada; vazios fazem o worker pular a etapa.
AISA_MAX_COST_USD=
JEV_MAX_COST_USD=

# AISA_LOCATION_NAME=Brazil
# A busca principal AISA usa o orçamento total da tarefa; Apify só após ativação no painel.
# Vendas: oferta, orçamento diário e tetos Jev/Hermes no painel Vendas Hermes.
# O orçamento comercial inicia em zero e a operação pausada.
# HERMES_SALES_HOME=/caminho/privado/hermes-sales
# HERMES_SALES_API_KEY= (opcional; padrão lê chave gerada no perfil isolado)
# ./pair-sales-whatsapp.sh ; ./run-sales-whatsapp-sync.sh
# ./run-sales-hermes.sh ; ./run-sales.sh

# Chave nativa Jev / TypeSafe (salva pela tela Integrações)
# TYPESAFE_API_KEY=
